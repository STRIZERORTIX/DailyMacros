# Copy to .env and fill in.
PORT=4000

# MongoDB Atlas free tier (M0) or local: mongodb://127.0.0.1:27017/kcal
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kcal?retryWrites=true&w=majority

# Auth. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to false after you have created your own account (stops strangers registering on a deployed server)
ALLOW_REGISTRATION=true

# Google sign-in (optional). Web client ID from Google Cloud Console > APIs & Services > Credentials.
# Authorized JavaScript origins must include http://localhost and http://localhost:5173 (and your deployed https URL).
GOOGLE_CLIENT_ID=

# Used from Stage 3 (food search). Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Browser origin allowed in production (dev uses the Vite proxy, so CORS is not needed)
CLIENT_ORIGIN=http://localhost:5173

# Web Push reminders. Generate a key pair with: npx web-push generate-vapid-keys
# Keep the private key secret. Set the same values in your deployed server environment.
VAPID_PUBLIC_KEY=BGTSFt6ngMKsdWaNNwp7C-XUBFBMfRuo7LS8xcIzWnQ2UosP9gW8YhuJsTftf9RM26gbji6H0PanfkIQ8zRb7Yk
VAPID_PRIVATE_KEY=yR5_6M8fBjEa95V7Hqjmu2zUjWyS1lCfet-_sVcYdbA
VAPID_SUBJECT=mailto:abhicreatesweb404@gmail.com
